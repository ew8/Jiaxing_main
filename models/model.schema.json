{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QR model document configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "pageTitle",
    "displayName",
    "model",
    "declarationModelNo",
    "nominalVoltage",
    "ratedCapacity",
    "batterySize",
    "batteryWeight",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "pageTitle": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Page 1 header model value, e.g. 6FM9 (12V9AH)"
    },
    "declarationModelNo": {
      "type": "string",
      "minLength": 1,
      "description": "Page 2 Model No. value, e.g. 6-FM-9  12V9"
    },
    "nominalVoltage": {
      "type": "string",
      "minLength": 1,
      "description": "Variable part only, e.g. 12V"
    },
    "ratedCapacity": {
      "type": "string",
      "minLength": 1,
      "description": "Variable part only. Suffix @20Hr, 25C stays on the template, e.g. 9Ah"
    },
    "batterySize": {
      "type": "string",
      "minLength": 1,
      "description": "Variable part only. mm suffix stays on the template, e.g. 151x65.5x100"
    },
    "batteryWeight": {
      "type": "string",
      "minLength": 1,
      "description": "Variable part only. (±3%) KG suffix stays on the template, e.g. 2.62"
    },
    "materials": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["chemical", "cas", "concentration"],
            "properties": {
              "chemical": { "type": "string" },
              "cas": { "type": "string" },
              "concentration": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
