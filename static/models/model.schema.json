{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model document configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "pageTitle",
    "displayName",
    "brand",
    "specifications",
    "contact",
    "warning",
    "certifications",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "pageTitle": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "logo"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "logo": {
          "type": "string",
          "pattern": "^\\./assets/"
        }
      }
    },
    "specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": [
        "manufacturer",
        "address",
        "email",
        "phone"
      ],
      "properties": {
        "manufacturer": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "required": [
        "title",
        "lines"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "src",
          "alt"
        ],
        "properties": {
          "key": {
            "enum": [
              "ul",
              "ce",
              "recycle",
              "extinguisher",
              "disposal"
            ]
          },
          "src": {
            "type": "string",
            "pattern": "^\\./assets/"
          },
          "alt": {
            "type": "string"
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "required": [
        "heading",
        "columns",
        "rows"
      ],
      "properties": {
        "heading": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "components",
                  "cas",
                  "tlv",
                  "weight"
                ],
                "properties": {
                  "components": {
                    "type": "string"
                  },
                  "cas": {
                    "type": "string"
                  },
                  "tlv": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "chemical",
                  "cas",
                  "classifications",
                  "concentration"
                ],
                "properties": {
                  "chemical": {
                    "type": "string"
                  },
                  "cas": {
                    "type": "string"
                  },
                  "classifications": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "type": "string"
                    }
                  },
                  "concentration": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
